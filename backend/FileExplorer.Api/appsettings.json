{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=/data/filexplorer.db"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "FileExplorer.Api",
    "Audience": "FileExplorer.Client",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 3650
  },
  "Admin": {
    "Username": "admin",
    "Password": ""
  },
  "FileSystem": {
    "RootPath": "/host_root",
    "TrashDirectoryName": ".filexplorer-trash"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
