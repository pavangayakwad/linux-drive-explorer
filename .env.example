# Copy this file to .env and fill in real values before running `docker compose up`.

# Required: random string, 32+ characters, used to sign JWTs. Generate one with:
#   openssl rand -base64 48
JWT_KEY=

# Optional: admin login. If ADMIN_PASSWORD is left blank, a random password is
# generated on first startup and printed once to `docker compose logs api`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
