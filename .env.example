# Copy this file to .env and fill in real values before running `docker compose up`.

# Required: random string, 32+ characters, used to sign JWTs. Generate one with:
#   openssl rand -base64 48
JWT_KEY=

# Optional: admin login. If ADMIN_PASSWORD is left blank, a random password is
# generated on first startup and printed once to `docker compose logs api`.
# If set, it must be 12+ characters and not a common password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: custom name shown under "Drive Explorer" in the sidebar and login page.
APP_NAME=

# Optional: enable the in-browser terminal. It is a ROOT shell on the host, so it is off by default.
TERMINAL_ENABLED=false

# Optional: set true only when behind a trusted reverse proxy that sets X-Forwarded-For
# (needed for per-client-IP login rate limiting to work correctly).
TRUST_FORWARDED_HEADERS=false
